{
    "name" : "ojooss/piradio",
    "description" : "piradio",
    "type": "project",
    "license": "MIT License",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "bretrzaun/statuspage": "^4.4",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.3",
        "twig/twig": "^3.3"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "mockery/mockery": "^1.4",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "migrate": [
            "php bin/console doctrine:migrations:migrate --allow-no-migration --quiet"
        ],
        "fixtures": [
            "php bin/console doctrine:fixtures:load --quiet"
        ],
        "test": [
            "php bin/console doctrine:migrations:migrate --allow-no-migration --quiet",
            "php bin/console doctrine:fixtures:load --quiet",
            "APP_ENV=test php bin/phpunit --exclude-group=needs-container"
        ],
        "rector": "vendor/bin/rector --dry-run",
        "phpstan": "php -d memory_limit=-1 vendor/bin/phpstan"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
